# 复制为 .env 后填入自己的 key，.env 不入库
DEEPSEEK_API_KEY=

# 可选：换模型或代理地址（默认 deepseek-chat 与官方接口）
# DEEPSEEK_MODEL=deepseek-chat
# DEEPSEEK_BASE_URL=https://api.deepseek.com

# 可选：文献 PDF 走对象存储时填。服务端据此把 /api/papers/{cat}/pdf 重定向过去。
# PDF_BASE_URL=https://pub-xxxx.r2.dev
# 本地 PDF 目录在别处时指定
# PDF_BASE=D:\资料\2020-2025年专业文献及政策案例作业

# 上传脚本用（scripts/upload_pdfs_r2.py）
# R2_ACCOUNT_ID=
# R2_ACCESS_KEY_ID=
# R2_SECRET_ACCESS_KEY=
# R2_BUCKET=

